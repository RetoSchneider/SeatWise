generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMINISTRATOR
}

enum OrganizerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum VenueStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SectionType {
  RESERVED
  GENERAL_ADMISSION
}

enum EventStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  CANCELLED
}

enum PerformanceStatus {
  SCHEDULED
  SOLD_OUT
  CANCELLED
  COMPLETED
}

enum RefundPolicy {
  NON_REFUNDABLE
  UNTIL_24_HOURS
  UNTIL_7_DAYS
}

enum InventoryState {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

enum ReservationStatus {
  ACTIVE
  CHECKOUT_PENDING
  CHECKED_OUT
  EXPIRED
  RELEASED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  PROCESSING
  SUCCEEDED
  DECLINED
  TIMED_OUT
  FAILED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  VOID
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  emailVerified        Boolean               @default(false)
  image                String?
  role                 Role                  @default(CUSTOMER)
  locale               String                @default("en-US")
  currency             String                @default("USD")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sessions             Session[]
  accounts             Account[]
  organizerProfile     OrganizerProfile?
  reservations         Reservation[]
  carts                Cart[]
  orders               Order[]
  tickets              Ticket[]
  refundRequests       RefundRequest[]       @relation("RefundRequester")
  reviewedRefunds      RefundRequest[]       @relation("RefundReviewer")
  notifications        Notification[]
  auditEvents          AuditEvent[]
  promotionRedemptions PromotionRedemption[]

  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model OrganizerProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  displayName    String
  status         OrganizerStatus @default(PENDING)
  supportEmail   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  venues         Venue[]
  events         Event[]
  promotionCodes PromotionCode[]
  orders         Order[]

  @@index([status])
  @@map("organizer_profiles")
}

model Venue {
  id           String           @id @default(cuid())
  organizerId  String
  name         String
  slug         String           @unique
  description  String
  addressLine1 String
  addressLine2 String?
  city         String
  region       String
  postalCode   String
  countryCode  String           @db.Char(2)
  timezone     String
  status       VenueStatus      @default(DRAFT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  organizer    OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  sections     VenueSection[]
  events       Event[]

  @@index([organizerId, status])
  @@map("venues")
}

model VenueSection {
  id          String       @id @default(cuid())
  venueId     String
  name        String
  type        SectionType
  sortOrder   Int
  capacity    Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  rows        VenueRow[]
  ticketTypes TicketType[]

  @@unique([venueId, name])
  @@index([venueId, sortOrder])
  @@map("venue_sections")
}

model VenueRow {
  id        String       @id @default(cuid())
  sectionId String
  label     String
  sortOrder Int
  section   VenueSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  seats     Seat[]

  @@unique([sectionId, label])
  @@index([sectionId, sortOrder])
  @@map("venue_rows")
}

model Seat {
  id            String          @id @default(cuid())
  rowId         String
  label         String
  sortOrder     Int
  accessible    Boolean         @default(false)
  companionSeat Boolean         @default(false)
  row           VenueRow        @relation(fields: [rowId], references: [id], onDelete: Cascade)
  inventory     SeatInventory[]
  tickets       Ticket[]

  @@unique([rowId, label])
  @@index([rowId, sortOrder])
  @@map("seats")
}

model Event {
  id             String           @id @default(cuid())
  organizerId    String
  venueId        String
  slug           String           @unique
  title          String
  summary        String
  description    String
  category       String
  status         EventStatus      @default(DRAFT)
  refundPolicy   RefundPolicy     @default(UNTIL_24_HOURS)
  salesStartAt   DateTime?
  salesEndAt     DateTime?
  publishedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organizer      OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  venue          Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  performances   Performance[]
  promotionCodes PromotionCode[]

  @@index([status, publishedAt])
  @@index([organizerId, status])
  @@index([venueId])
  @@map("events")
}

model Performance {
  id                         String                      @id @default(cuid())
  eventId                    String
  startsAt                   DateTime
  doorsAt                    DateTime?
  endsAt                     DateTime?
  salesStartAt               DateTime
  salesEndAt                 DateTime
  reservationDurationMinutes Int                         @default(10)
  status                     PerformanceStatus           @default(SCHEDULED)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  event                      Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypes                TicketType[]
  seatInventory              SeatInventory[]
  generalAdmissionInventory  GeneralAdmissionInventory[]
  reservations               Reservation[]
  orders                     Order[]
  orderLines                 OrderLine[]
  tickets                    Ticket[]

  @@index([eventId, startsAt])
  @@index([status, startsAt])
  @@map("performances")
}

model TicketType {
  id                        String                     @id @default(cuid())
  performanceId             String
  sectionId                 String?
  name                      String
  description               String?
  priceCents                Int
  currency                  String                     @db.Char(3)
  minPerOrder               Int                        @default(1)
  maxPerOrder               Int                        @default(8)
  salesStartAt              DateTime
  salesEndAt                DateTime
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  performance               Performance                @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  section                   VenueSection?              @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  seatInventory             SeatInventory[]
  generalAdmissionInventory GeneralAdmissionInventory?
  reservationItems          ReservationItem[]
  orderLines                OrderLine[]

  @@unique([performanceId, name])
  @@index([performanceId])
  @@map("ticket_types")
}

model SeatInventory {
  id                  String            @id @default(cuid())
  performanceId       String
  seatId              String
  ticketTypeId        String
  state               InventoryState    @default(AVAILABLE)
  activeReservationId String?
  reservedUntil       DateTime?
  soldOrderLineId     String?           @unique
  version             Int               @default(0)
  updatedAt           DateTime          @updatedAt
  performance         Performance       @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  seat                Seat              @relation(fields: [seatId], references: [id], onDelete: Restrict)
  ticketType          TicketType        @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  activeReservation   Reservation?      @relation("ActiveReservationInventory", fields: [activeReservationId], references: [id], onDelete: SetNull)
  soldOrderLine       OrderLine?        @relation("SoldSeatInventory", fields: [soldOrderLineId], references: [id], onDelete: Restrict)
  reservationItems    ReservationItem[]

  @@unique([performanceId, seatId])
  @@index([performanceId, state])
  @@index([activeReservationId])
  @@index([reservedUntil])
  @@map("seat_inventory")
}

model GeneralAdmissionInventory {
  id            String      @id @default(cuid())
  performanceId String
  ticketTypeId  String      @unique
  capacity      Int
  reserved      Int         @default(0)
  sold          Int         @default(0)
  version       Int         @default(0)
  updatedAt     DateTime    @updatedAt
  performance   Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  ticketType    TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([performanceId])
  @@map("general_admission_inventory")
}

model Reservation {
  id                  String            @id @default(cuid())
  userId              String
  performanceId       String
  status              ReservationStatus @default(ACTIVE)
  expiresAt           DateTime
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  performance         Performance       @relation(fields: [performanceId], references: [id], onDelete: Restrict)
  items               ReservationItem[]
  activeSeatInventory SeatInventory[]   @relation("ActiveReservationInventory")
  cart                Cart?
  orders              Order[]

  @@index([userId, status])
  @@index([performanceId, status])
  @@index([expiresAt, status])
  @@map("reservations")
}

model ReservationItem {
  id              String         @id @default(cuid())
  reservationId   String
  ticketTypeId    String
  seatInventoryId String?
  quantity        Int
  unitPriceCents  Int
  currency        String         @db.Char(3)
  reservation     Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketType      TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  seatInventory   SeatInventory? @relation(fields: [seatInventoryId], references: [id], onDelete: Restrict)
  cartItem        CartItem?
  orderLines      OrderLine[]

  @@unique([reservationId, seatInventoryId])
  @@index([reservationId])
  @@map("reservation_items")
}

model Cart {
  id              String         @id @default(cuid())
  userId          String
  reservationId   String         @unique
  promotionCodeId String?
  status          CartStatus     @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation     Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  promotionCode   PromotionCode? @relation(fields: [promotionCodeId], references: [id], onDelete: SetNull)
  items           CartItem[]

  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id                String          @id @default(cuid())
  cartId            String
  reservationItemId String          @unique
  quantity          Int
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  reservationItem   ReservationItem @relation(fields: [reservationItemId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

model PromotionCode {
  id                   String                @id @default(cuid())
  organizerId          String
  eventId              String?
  code                 String                @unique
  description          String
  type                 PromotionType
  value                Int
  minimumSubtotalCents Int                   @default(0)
  maximumDiscountCents Int?
  startsAt             DateTime
  endsAt               DateTime
  redemptionLimit      Int?
  limitPerCustomer     Int                   @default(1)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organizer            OrganizerProfile      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  event                Event?                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  carts                Cart[]
  orders               Order[]
  redemptions          PromotionRedemption[]

  @@index([organizerId, active])
  @@index([eventId])
  @@index([startsAt, endsAt])
  @@map("promotion_codes")
}

model PromotionRedemption {
  id              String        @id @default(cuid())
  promotionCodeId String
  userId          String
  orderId         String        @unique
  discountCents   Int
  redeemedAt      DateTime      @default(now())
  promotionCode   PromotionCode @relation(fields: [promotionCodeId], references: [id], onDelete: Restrict)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([promotionCodeId, userId])
  @@map("promotion_redemptions")
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  userId              String
  organizerId         String
  performanceId       String
  reservationId       String
  promotionCodeId     String?
  idempotencyKey      String
  requestHash         String?
  status              OrderStatus          @default(PENDING_PAYMENT)
  currency            String               @db.Char(3)
  subtotalCents       Int
  discountCents       Int                  @default(0)
  feeCents            Int                  @default(0)
  totalCents          Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paidAt              DateTime?
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  organizer           OrganizerProfile     @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  performance         Performance          @relation(fields: [performanceId], references: [id], onDelete: Restrict)
  reservation         Reservation          @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  promotionCode       PromotionCode?       @relation(fields: [promotionCodeId], references: [id], onDelete: SetNull)
  lines               OrderLine[]
  paymentAttempts     PaymentAttempt[]
  tickets             Ticket[]
  refundRequests      RefundRequest[]
  refunds             Refund[]
  promotionRedemption PromotionRedemption?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([organizerId, createdAt])
  @@index([performanceId, status])
  @@map("orders")
}

model OrderLine {
  id                String          @id @default(cuid())
  orderId           String
  performanceId     String
  ticketTypeId      String
  reservationItemId String
  description       String
  quantity          Int
  unitPriceCents    Int
  totalCents        Int
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  performance       Performance     @relation(fields: [performanceId], references: [id], onDelete: Restrict)
  ticketType        TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  reservationItem   ReservationItem @relation(fields: [reservationItemId], references: [id], onDelete: Restrict)
  seatInventory     SeatInventory?  @relation("SoldSeatInventory")
  tickets           Ticket[]

  @@index([orderId])
  @@index([performanceId])
  @@index([reservationItemId])
  @@map("order_lines")
}

model PaymentAttempt {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerReference String?
  attemptNumber     Int
  status            PaymentStatus @default(PROCESSING)
  amountCents       Int
  currency          String        @db.Char(3)
  idempotencyKey    String        @unique
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@unique([orderId, attemptNumber])
  @@index([orderId, status])
  @@map("payment_attempts")
}

model Ticket {
  id            String       @id @default(cuid())
  ticketNumber  String       @unique
  qrToken       String       @unique
  orderId       String
  orderLineId   String
  userId        String
  performanceId String
  seatId        String?
  status        TicketStatus @default(VALID)
  issuedAt      DateTime     @default(now())
  checkedInAt   DateTime?
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLine     OrderLine    @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  performance   Performance  @relation(fields: [performanceId], references: [id], onDelete: Restrict)
  seat          Seat?        @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@index([userId, issuedAt])
  @@index([performanceId, status])
  @@map("tickets")
}

model RefundRequest {
  id                   String       @id @default(cuid())
  orderId              String
  userId               String
  reviewedById         String?
  status               RefundStatus @default(REQUESTED)
  reason               String
  requestedAmountCents Int
  processedAmountCents Int?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  resolvedAt           DateTime?
  order                Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requester            User         @relation("RefundRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy           User?        @relation("RefundReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  refund               Refund?

  @@index([orderId, status])
  @@index([userId, createdAt])
  @@map("refund_requests")
}

model Refund {
  id                String         @id @default(cuid())
  orderId           String
  refundRequestId   String?        @unique
  paymentAttemptId  String
  providerReference String?
  amountCents       Int
  status            RefundStatus   @default(PROCESSING)
  createdAt         DateTime       @default(now())
  completedAt       DateTime?
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refundRequest     RefundRequest? @relation(fields: [refundRequestId], references: [id], onDelete: SetNull)
  paymentAttempt    PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@map("refunds")
}

model Notification {
  id             String              @id @default(cuid())
  userId         String
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  type           String
  recipient      String
  subject        String
  body           String
  failureMessage String?
  createdAt      DateTime            @default(now())
  sentAt         DateTime?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  ipHash      String?
  userAgent   String?
  metadata    Json
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model RateLimitBucket {
  key         String
  action      String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([key, action, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
